# Required for local development with Vite proxy:
# Google Gemini API key for blueprint generation (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API key for high-availability automatic fallback
# (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: Production Backend Base URL
# When set, the frontend will call remote endpoints (e.g. Supabase Edge Functions)
# Leave unset or empty for local Vite development middleware proxying (/api/*)
# Example: https://zrxgkyhzqdyyqtsmwixy.supabase.co/functions/v1
VITE_API_BASE_URL=
